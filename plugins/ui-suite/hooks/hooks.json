{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Artifact|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ui-taste-inject.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ui-taste-inject.py\"",
            "timeout": 10,
            "statusMessage": "ui-taste after compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-ui-gate.py\"",
            "timeout": 10,
            "statusMessage": "lint-ui gate"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/break-gate.py\"",
            "timeout": 10,
            "statusMessage": "break gate"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/break-gate.py\"",
            "timeout": 10,
            "statusMessage": "break gate"
          }
        ]
      }
    ]
  }
}
