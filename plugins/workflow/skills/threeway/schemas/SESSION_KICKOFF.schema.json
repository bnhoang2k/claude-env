{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "threeway/1.0 SESSION_KICKOFF",
  "type": "object",
  "required": [
    "protocol",
    "type",
    "session_id",
    "message_id",
    "repo",
    "task",
    "mode",
    "objective",
    "open_question"
  ],
  "properties": {
    "protocol": {
      "const": "threeway/1.0"
    },
    "type": {
      "const": "SESSION_KICKOFF"
    },
    "session_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "reply_to": {
      "type": "string"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "blind",
        "informed",
        "staged"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "open_question": {
      "type": "string",
      "minLength": 1
    }
  }
}
