{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "threeway/1.0 SESSION_KICKOFF",
  "type": "object",
  "required": [
    "protocol",
    "type",
    "session_id",
    "message_id",
    "repo",
    "task",
    "mode",
    "objective",
    "open_question"
  ],
  "properties": {
    "protocol": {
      "const": "threeway/1.0"
    },
    "type": {
      "const": "SESSION_KICKOFF"
    },
    "session_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "reply_to": {
      "type": "string"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "blind",
        "informed",
        "staged"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "open_question": {
      "type": "string",
      "minLength": 1
    },
    "continues_from": {
      "type": "string",
      "minLength": 1,
      "description": "the old chat's URL and the handoff that seeds this chat"
    },
    "next_ids": {
      "type": "object",
      "required": [
        "REQ",
        "iteration"
      ],
      "description": "{REQ: next request ID, iteration: current iteration}",
      "properties": {
        "REQ": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}$"
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "dependentRequired": {
    "continues_from": [
      "next_ids"
    ]
  }
}
